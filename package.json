{
    "name": "weweb-server",
    "version": "1.0.0",
    "type": "module",
    "main": "src/index_server.ts",
    "scripts": {
        "postinstall": "node ./init-data.ts",
        "start": "node src/index_server.ts",
        "start:dev": "cross-env NODE_ENV=development ENV=editor node --watch src/index_server.ts",
        "build": "npm run build:server",
        "build:lambda": "tsdown --entry ./src/index_lambda.ts",
        "build:server": "tsdown --entry ./src/index_server.ts",
        "db:generate": "npx @weweb/cli@latest db:generate --source-db-url \"$SOURCE_DB_URL\" --target-db-url \"$TARGET_DB_URL\" --output-file \"${MIGRATION_FILE:-./migration.sql}\"",
        "db:execute": "npx @weweb/cli@latest db:execute --db-url \"$TARGET_DB_URL\" --sql-file \"${MIGRATION_FILE:-./migration.sql}\"",
        "db:execute:dry-run": "npx @weweb/cli@latest db:execute --db-url \"$TARGET_DB_URL\" --sql-file \"${MIGRATION_FILE:-./migration.sql}\" --dry-run",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --exclude=src/services/database/formulaV2QueryBuilder.postgres.test.ts",
        "test:formula-v2:postgres": "vitest run --config vitest.formula-v2-postgres.config.ts",
        "test:dev": "vitest"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.74",
        "@ai-sdk/deepseek": "^2.0.32",
        "@ai-sdk/google": "^3.0.67",
        "@ai-sdk/mistral": "^3.0.33",
        "@ai-sdk/openai": "^3.0.58",
        "@ai-sdk/xai": "^3.0.87",
        "@aws-sdk/client-s3": "3.1011.0",
        "@aws-sdk/s3-request-presigner": "3.1003.0",
        "@better-fetch/fetch": "1.1.21",
        "@google-cloud/storage": "7.19.0",
        "@googleapis/calendar": "14.2.0",
        "@googleapis/docs": "10.0.0",
        "@googleapis/drive": "22.0.0",
        "@googleapis/sheets": "13.0.1",
        "@hono/node-server": "1.19.11",
        "@hubspot/api-client": "14.0.1",
        "@makehq/sdk": "1.6.0",
        "@mondaydotcomorg/api": "14.0.0",
        "@notionhq/client": "5.22.0",
        "@segment/analytics-node": "3.0.0",
        "@sendgrid/mail": "8.1.6",
        "@slack/web-api": "7.14.1",
        "@supabase/supabase-js": "2.98.0",
        "@xano/js-sdk": "3.0.1",
        "ai": "6.0.174",
        "better-auth": "1.5.6",
        "better-call": "2.0.1",
        "cloudinary": "2.9.0",
        "customerio-node": "4.3.0",
        "flydrive": "2.0.0",
        "google-auth-library": "10.6.2",
        "hono": "4.12.8",
        "intercom-client": "7.0.3",
        "jose": "6.2.10",
        "kysely": "0.28.11",
        "mysql2": "3.19.0",
        "openai": "6.27.0",
        "pg": "8.20.0",
        "postmark": "4.0.7",
        "resend": "6.9.3",
        "stripe": "22.0.0",
        "tarn": "3.0.2",
        "tedious": "19.2.1",
        "twilio": "6.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "25.4.0",
        "@types/pg": "8.18.0",
        "cross-env": "10.1.0",
        "tsdown": "0.22.14",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "engines": {
        "node": ">=24.11.0"
    },
    "author": "weweb-team"
}
